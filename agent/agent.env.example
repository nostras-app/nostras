# Copy to agent.env (gitignored, matches the root .gitignore's *.env
# pattern) — or just run the daemon once with none of these set and it
# will generate NOSTR_AGENT_NSEC itself on first boot and append it here.

# The agent's own persisted Nostr identity (hex or nsec). Generated
# automatically on first boot if unset — do not hand-edit unless you know
# what you're doing; see identity.js's own comment on why a corrupt value
# is a hard failure, not a silent regenerate.
# NOSTR_AGENT_NSEC=

# Overrides the hardcoded owner allowlist (the real MMO pubkey). Only set
# this if running the daemon for a different owner.
# NOSTR_AGENT_OWNER_PUBKEY=

# Per-invocation cost ceiling passed to `claude --max-budget-usd`. Default
# 5 if unset.
# NOSTR_AGENT_MAX_BUDGET_USD=5

# Wall-clock timeout (ms) per Claude Code invocation before it's killed.
# Default 600000 (10 minutes) if unset.
# NOSTR_AGENT_CLAUDE_TIMEOUT_MS=600000

# --- Evangelist (see EVANGELIST-PLAN.md) ---

# The agent's own Lightning wallet (NWC, nostr+walletconnect://...). Never
# your own or the DVM's wallet. Required for the wallet and zap commands.
# AGENT_NWC_URI=

# Anything but 0 means dry run: posts and zaps are logged, never published or paid.
# AGENT_DRY_RUN=1

# Scales the daily limits (posts, replies, likes, zap sats). 0.5 = half.
# AGENT_CAP_SCALE=1

# Model for each run, daily Claude cap (USD), per-run cap (USD).
# AGENT_EVANGELIST_MODEL=sonnet
# AGENT_DAILY_COST_USD=2
# AGENT_RUN_BUDGET_USD=0.75

# Starting sats, used for the goal (100x starting sats + live Claude cost).
# AGENT_START_SATS=2500
